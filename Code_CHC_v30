/* Nível de acesso de cada Função cadastrada na aba "Usuários". Mantido
   aqui (e não só no HTML) para a ação de login devolver, junto com o
   nome/função da pessoa, o rótulo de acesso já pronto — assim o app não
   precisa reimplementar essa tabela em dois lugares. Se um novo cargo for
   criado na planilha e não estiver aqui, cai no padrão "Visualização dos
   Voos" (o mais restrito), nunca em acesso total. */
const ACCESS_BY_FUNCTION={
  'ADMINISTRADOR':'Acesso total',
  'COORDENADOR':'Acesso limitado',
  'ATENDIMENTO':'Visualização dos Voos',
  'MANUTENCAO':'Visualização dos Voos',
  'ADMINISTRATIVO':'Visualização dos Voos',
  'ABASTECEDOR':'Abastecimento'
};
function accessForFunction(funcao){
  const key=normKey(funcao);
  return ACCESS_BY_FUNCTION[key]||'Visualização dos Voos';
}

function adminPermissions(){
  return {
    painel:true,operacao:true,historico:true,
    criarVoo:true,editarVoo:true,finalizarVoo:true,cancelarVoo:true,transferirVoo:true,adicionarTrecho:true,
    verAeronaves:true,editarAeronaves:true,relatorios:true,parametros:true,plataformas:true,tripulacao:true,
    bases:true,clientes:true,rotas:true,codigosAtraso:true,listas:true,configuracoes:true,usuarios:true,seguranca:true
  };
}

/* Permissões por Função.
   Administrador mantém as permissões atuais.
   Coordenador recebe acesso operacional limitado, sem acesso administrativo.
   Demais funções permanecem sem permissões administrativas por padrão. */
function permissionsForFunction(funcao){
  const key=normKey(funcao);

  if(key==='ADMINISTRADOR') return adminPermissions();

  if(key==='COORDENADOR'){
    return {
      painel:true,operacao:true,historico:true,
      criarVoo:true,editarVoo:true,finalizarVoo:true,cancelarVoo:true,transferirVoo:true,adicionarTrecho:true,
      verAeronaves:true,editarAeronaves:false,relatorios:true,parametros:false,plataformas:false,tripulacao:true,
      bases:false,clientes:false,rotas:false,codigosAtraso:true,listas:true,configuracoes:false,usuarios:false,seguranca:false
    };
  }

  /* Abastecedor: acesso exclusivo à aba de Abastecimento. Não enxerga
     Painel, Voos em Operação, Histórico, Aeronaves nem Configurações —
     só a lista de solicitações de abastecimento pendentes. */
  if(key==='ABASTECEDOR'){
    return {
      painel:false,operacao:false,historico:false,
      criarVoo:false,editarVoo:false,finalizarVoo:false,cancelarVoo:false,transferirVoo:false,adicionarTrecho:false,
      verAeronaves:false,editarAeronaves:false,relatorios:false,parametros:false,plataformas:false,tripulacao:false,
      bases:false,clientes:false,rotas:false,codigosAtraso:false,listas:false,configuracoes:false,usuarios:false,seguranca:false,
      abastecimento:true
    };
  }

  return {};
}

function doGet(e){return handle(e)}
function doPost(e){return handle(e)}

function handle(e){
  try{
    const params=(e&&e.parameter)||{};
    const body=(e&&e.postData&&e.postData.contents)?JSON.parse(e.postData.contents):{};
    const token=params.token||body.token;
    if(token!==TOKEN)return json({error:'não autorizado'});

    const action=params.action||body.action;
    const type=params.type||body.type;

    /* Diagnóstico: confirma que o Web App publicado está executando esta
       versão e que a conta do Apps Script consegue abrir a planilha. */
    if(action==='ping')return json(pingBackend());

    /* Login: recebe o nome digitado na tela inicial, procura na aba
       "Usuários" (por nome, ignorando acento/caixa/espaços extras) e,
       se achar, devolve a Função cadastrada e o nível de acesso
       correspondente. Se não achar, devolve autorizado:false — o app
       deve bloquear a entrada na Central nesse caso. */
    if(action==='login'&&type==='user')return json(loginUser(params.nome||body.nome));
    if(action==='login'&&type==='adminCredential')return json(verifyAdminCredential(body.nome||params.nome,body.senha||params.senha,body.base||params.base));
    if(action==='security'&&type==='changeCredential')return json(changeAdminCredential(body.nome||params.nome,body.senha||params.senha));

    if(action==='list'&&type==='flights')return json(listFlights(params.base));
    if(action==='list'&&type==='auditFlights')return json(listAuditFlights(body||params,body.actor||{}));
    if(action==='list'&&type==='flightAudit')return json(listFlightAudit(params.flightId||body.flightId,body.actor||{}));
    if(action==='list'&&type==='auditExport')return json(listAuditExport(body||params,body.actor||{}));
    if(action==='create'&&type==='flight')return json(createFlight(body.flight,body.actor||{}));
    if(action==='update'&&type==='flight')return json(updateFlight(body.id,body.flight,body.actor||{}));
    if(action==='delete'&&type==='flight')return json({ok:deleteFlight(body.id,body.actor||{})});

    /* Aba Abastecimento: lista as solicitações pendentes (de todas as
       bases) para o operador de abastecimento, e permite marcar uma
       solicitação como concluída. */
    if(action==='list'&&type==='abastecimentosPendentes')return json(listPendingFuelRequests());
    if(action==='update'&&type==='abastecimento')return json(concluirAbastecimento(body.id||params.id,body.actor||{}));

    if(action==='list'&&type==='config')return json(listConfig(params.key||body.key));
    if(action==='add'&&type==='config')return json(addConfig(body.key,body.data));
    if(action==='update'&&type==='config')return json(updateConfig(body.key,body.id,body.data));
    if(action==='delete'&&type==='config')return json({ok:deleteConfig(body.key,body.id)});

    /* Ações específicas usadas pela tela de Aeronaves (modais "ALTERAR
       BASE" e "DEFINIR BACKUP"). O front-end manda {action:'updateAircraftBase',
       type:'config'} e {action:'updateAircraftBackup', type:'config'} — sem
       estas duas linhas, essas chamadas caíam direto no "ação desconhecida"
       abaixo, mesmo com updateDedicated() já pronto para gravar Base/Backup. */
    if(action==='updateAircraftBase'&&type==='config')return json(updateAircraftBaseBulk(body.tails||params.tails,body.base||params.base));
    if(action==='updateAircraftBackup'&&type==='config')return json(updateAircraftBackupSingle(body.tail||params.tail,body.backup||params.backup));
    if(action==='updateAircraftStatus'&&type==='config')return json(updateAircraftStatusSingle(body.tail||params.tail,body.status||params.status));

    /* Indisponibilidade de aeronaves (aba dedicada "Indisponibilidades",
       com histórico completo — ver nota de versão v23 no topo do arquivo). */
    if(action==='create'&&type==='indisponibilidade')return json(criarIndisponibilidade(body.tail||params.tail,body,body.actor||{}));
    if(action==='update'&&type==='indisponibilidade')return json(disponibilizarAeronave(body.tail||params.tail,body,body.actor||{}));
    if(action==='updateOpen'&&type==='indisponibilidade')return json(atualizarIndisponibilidadeAberta(body.tail||params.tail,body,body.actor||{}));
    if(action==='list'&&type==='indisponibilidadesAbertas')return json(listIndisponibilidadesAbertas());
    if(action==='list'&&type==='indisponibilidadesHistorico')return json(listIndisponibilidadesHistorico(params.tail||body.tail,params.dias||body.dias));
    if(action==='translate'&&type==='ptEn')return json({texto:translatePtToEn(body.texto||params.texto)});

    /* Envio de e-mail de verdade (v30): usa o serviço MailApp, nativo do
       Apps Script — sai da conta Google que publicou o Web App, sem precisar
       de servidor SMTP nem chave externa. Antes disso o front-end só abria
       o app de e-mail do coordenador (mailto:); agora o botão "Enviar
       e-mail" da prévia chama esta ação e o Apps Script manda direto. */
    if(action==='send'&&type==='email')return json(enviarEmailIndisponibilidade(body));

    /* Indicadores de tendência (Painel de Voos): histórico diário de
       disponibilidade da frota, usado para calcular "média 7 dias". */
    if(action==='snapshot'&&type==='disponibilidade')return json(registrarSnapshotDisponibilidade());
    if(action==='list'&&type==='disponibilidadeHistorico')return json(listFleetAvailabilityHistory(params.dias||body.dias));
    if(action==='snapshot'&&type==='disponibilidadePorModelo')return json(registrarSnapshotDisponibilidadePorModelo());
    if(action==='list'&&type==='disponibilidadeHistoricoPorModelo')return json(listFleetAvailabilityHistoryByModel(params.dias||body.dias));

    /* Depuração: mostra o que o script está enxergando de fato numa aba
       dedicada — nome da aba encontrada, cabeçalho bruto (linha 1) e para
       que campo cada coluna foi mapeada. Útil para descobrir por que um
       cadastro não está "puxando" nada, sem precisar tirar print da
       planilha. Chame assim na barra do navegador (troque SEU_TOKEN e,
       se quiser, a chave):
       .../exec?token=SEU_TOKEN&action=debug&type=config&key=plataformas */
    if(action==='debug'&&type==='config')return json(debugDedicatedHeaders(params.key||body.key));

    return json({error:'ação desconhecida: '+action+'/'+type});
  }catch(err){
    return json({error:String(err)});
  }
}

/* Planilha principal — sempre a mesma, aberta pelo ID (não depende mais de
   o script estar "amarrado" a uma planilha específica). */
function mainSS(){
  return SpreadsheetApp.openById(SPREADSHEET_ID);
}

function sheet(name){
  const ss=mainSS();
  let sh=ss.getSheetByName(name);
  if(!sh){
    sh=ss.insertSheet(name);
    if(name==='Voos')sh.appendRow(['id','base','json','atualizadoEm']);
    if(name==='Config')sh.appendRow(['id','key','json']);
  }
  return sh;
}

/* ---------- Voos ---------- */
function normBase(v){return String(v||'').trim().normalize('NFC')}
function listFlights(base){
  const sh=sheet('Voos');
  const rows=sh.getDataRange().getValues();
  const out=[];
  const baseNorm=normBase(base);
  for(let i=1;i<rows.length;i++){
    let[id,rowBase,jsonStr]=rows[i];
    if(!jsonStr)continue; // linha vazia de verdade, ignora
    if(!id){
      /* Registro lançado direto na planilha, sem id — cura sozinho
         gerando um novo id e gravando de volta, assim ele passa a ser
         editável/excluível normalmente pelo app. */
      id=Utilities.getUuid();
      sh.getRange(i+1,1).setValue(id);
    }
    if(baseNorm&&normBase(rowBase)!==baseNorm)continue;
    out.push(Object.assign({id:id},JSON.parse(jsonStr)));
  }
  return out;
}
/* ---------- Abastecimento ---------- */
/* Varre a aba Voos (todas as bases) e devolve os voos com abastecimento
   solicitado: pendentes e concluídos — o histórico de concluídos fica
   disponível permanentemente na aba Abastecimento para consulta futura
   por data (não é apagado automaticamente). */
function listPendingFuelRequests(){
  const sh=sheet('Voos');
  const rows=sh.getDataRange().getValues();
  const out=[];
  for(let i=1;i<rows.length;i++){
    let[id,rowBase,jsonStr]=rows[i];
    if(!jsonStr)continue;
    let f;
    try{f=JSON.parse(jsonStr);}catch(e){continue;}
    const log=f.logVoo||{};
    if(!log.abastecimentoSolicitado)continue;
    const status=log.abastecimentoStatus==='CONCLUIDO'?'CONCLUIDO':'PENDENTE';
    out.push({
      id:id||f.id||'',
      base:rowBase||f.base||'',
      reg:f.reg||'',
      flightNo:f.flightNo||'',
      cliente:f.cliente||'',
      destino:f.destino||'',
      horario:f.horario||'',
      dataVoo:f.dataVoo||'',
      combustivelTotal:(f.pesos&&f.pesos.combustivelTotal)||f.combustivelTotal||'',
      // v21 — valor efetivamente solicitado no momento do pedido (interno em kg).
      // Para registros antigos, mantém fallback para o combustível total legado.
      abastecimentoCombustivelSolicitadoKg:log.abastecimentoCombustivelSolicitadoKg??((f.pesos&&f.pesos.combustivelTotal)||f.combustivelTotal||''),
      status:status,
      abastecimentoSolicitadoEm:log.abastecimentoSolicitadoEm||'',
