/* ---- Reconhecimento de cabeçalho tolerante a acento/caixa/variação ----
   O app espera nomes de campo específicos (os mesmos das telas de
   cadastro). Para não depender de a planilha usar exatamente esse texto,
   comparamos os títulos ignorando acento e maiúscula/minúscula, e ainda
   aceitamos alguns apelidos conhecidos (ex.: "PMD/KG" = "Peso Máximo de
   Decolagem (PMD)"). Se aparecer outro título "torto", é só acrescentar
   aqui em CONFIG_HEADER_SYNONYMS — não precisa mexer na planilha. */
function stripAccents(s){
  return String(s||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'');
}
function normKey(s){
  return stripAccents(s).trim().toUpperCase().replace(/[^A-Z0-9]+/g,' ').trim().replace(/\s+/g,' ');
}
