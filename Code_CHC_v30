function findDedicatedSheet(key){
  const conf=DEDICATED_SHEETS[key];
  if(!conf)return null;
  const ss=mainSS();
  if(conf.gid!=null){
    const byId=ss.getSheets().filter(s=>s.getSheetId()===conf.gid)[0];
    if(byId)return byId;
  }
  const sheets=ss.getSheets();
  /* 1) casamento exato, ignorando acento/maiúscula (ex.: "Usuários" bate
     com "usuarios"). */
  const wantedExact=conf.names.map(n=>normKey(n));
  let found=sheets.filter(s=>wantedExact.indexOf(normKey(s.getName()))>=0)[0];
  if(found)return found;
  /* 2) casamento tolerante por singular/plural ou nome parcial (ex.: aba
     chamada "usuário" bate com o esperado "Usuários", e "BASE" bate com
     "Bases") — evita que o cadastro pare de funcionar só porque a aba
     foi renomeada de um jeito parecido. */
  found=sheets.filter(s=>{
    const sn=normKey(s.getName());
    if(!sn)return false;
    return wantedExact.some(w=>sn.indexOf(w)>=0||w.indexOf(sn)>=0);
  })[0];
  return found||null;
}

