function fuzzyMatchField(key,trimmedHeader,alreadyUsed){
  const list=CONFIG_FIELD_KEYWORDS[key];
  if(!list)return null;
  const norm=normKey(trimmedHeader);
  for(let i=0;i<list.length;i++){
    const field=list[i][0],keywords=list[i][1];
    if(alreadyUsed.indexOf(field)>=0)continue; // cada campo só é usado 1x
    for(let k=0;k<keywords.length;k++){
      if(norm.indexOf(keywords[k])>=0)return field;
    }
  }
  return null;
}
/* Para cada título bruto da planilha, devolve o nome canônico do campo
   (se reconhecido) ou o próprio título (sem perder nenhuma coluna extra
   que a planilha tenha e o app ainda não conheça). */
function buildHeaderMap(key,rawHeaders){
  const canonical=CONFIG_CANONICAL_FIELDS[key]||[];
  const byNorm={};
  canonical.forEach(c=>{byNorm[normKey(c)]=c});
  const synonyms=CONFIG_HEADER_SYNONYMS[key]||{};
  Object.keys(synonyms).forEach(raw=>{byNorm[normKey(raw)]=synonyms[raw]});
  const usedCanonical=[]; // evita mapear duas colunas da planilha para o mesmo campo do app
  return rawHeaders.map(h=>{
    const trimmed=String(h||'').trim();
    if(!trimmed)return '';
    const exact=byNorm[normKey(trimmed)];
    if(exact){usedCanonical.push(exact);return exact}
    const fuzzy=fuzzyMatchField(key,trimmed,usedCanonical);
    if(fuzzy){usedCanonical.push(fuzzy);return fuzzy}
    return trimmed; // título desconhecido: mantém como está, não perde a coluna
  });
}

/* Garante que a aba Aeronaves tenha os campos necessários para as
   funções novas de Base e Backup. Se a planilha antiga não possuía essas
   colunas, elas são criadas automaticamente no final do cabeçalho. */
function ensureDedicatedHeaders(key,sh){
  if(key!=='aeronaves' && key!=='usuarios')return;
  const lastCol=Math.max(sh.getLastColumn(),1);
  const raw=sh.getRange(1,1,1,lastCol).getValues()[0].map(h=>String(h||'').trim());
  const mapped=buildHeaderMap(key,raw);
  const required=key==='usuarios'?['Permissões']:['Base','Backup'];
  required.forEach(field=>{
    if(mapped.indexOf(field)<0){
      const newCol=sh.getLastColumn()+1;
      sh.getRange(1,newCol).setValue(field);
    }
  });
}

/* Lê a linha 1 como cabeçalho e devolve um objeto por linha, ex.:
   {id:'628550820:5', 'Matrícula':'PR-CGP', 'Modelo':'AW139', ...}
   O id é recalculado a cada listagem — sempre "gid:linha-na-planilha" —
   então funciona mesmo em linhas digitadas direto na planilha, sem
   precisar de nenhuma coluna extra de id. */
function listDedicated(key){
  const sh=findDedicatedSheet(key);
  if(!sh)return[];
  ensureDedicatedHeaders(key,sh);
  const values=sh.getDataRange().getValues();
  if(values.length<2)return[];
  const rawHeaders=values[0].map(h=>String(h||'').trim());
  const headers=buildHeaderMap(key,rawHeaders);
  const gid=sh.getSheetId();
  const out=[];
  for(let i=1;i<values.length;i++){
    const row=values[i];
    if(row.every(c=>c===''||c===null))continue; // linha totalmente vazia
    const rec={id:gid+':'+(i+1)};
    /* CORREÇÃO (v16): se duas colunas da planilha mapeiam para o mesmo
       campo (ex.: "Função" e, mais adiante, uma segunda coluna também
       chamada "FUNÇÃO", ou uma coluna "ACESSO" reconhecida como
       apelido), a versão antiga sempre deixava a última coluna
       sobrescrever a anterior — mesmo que a última estivesse vazia ou
       guardasse outra coisa. Foi exatamente isso que fez o Coordenador
       cair sempre em "Visualização dos Voos": a segunda coluna
       "FUNÇÃO"/"ACESSO" apagava o valor certo da primeira. Agora,
       dentro da mesma linha, a primeira coluna que trouxer um valor
       não-vazio para aquele campo é a que vale; colunas duplicadas
       vazias, ou preenchidas por engano depois, não sobrescrevem mais. */
    headers.forEach((h,c)=>{
      if(!h)return;
      const val=formatCellValue(row[c]);
      const jaTemValor=rec[h]!==undefined && rec[h]!==null && rec[h]!=='';
      if(!jaTemValor)rec[h]=val;
    });
    out.push(rec);
  }
  return out;
}

