function addDedicated(key,data){
  const sh=findDedicatedSheet(key);
  if(!sh)throw new Error('Não encontrei a aba de "'+key+'" na planilha. Confira o nome/GID configurado no Code.gs.');
  ensureDedicatedHeaders(key,sh);
  const headers=dedicatedHeaders(sh,key);
  const row=headers.map(h=>(data[h]!==undefined&&data[h]!==null)?data[h]:'');
  sh.appendRow(row);
  const newRowNum=sh.getLastRow();
  return Object.assign({id:sh.getSheetId()+':'+newRowNum},data);
}

function parseDedicatedId(id){
  const s=String(id||'');
  const idx=s.indexOf(':');
  if(idx<0)return null;
  return{gid:Number(s.slice(0,idx)),row:Number(s.slice(idx+1))};
}

function updateDedicated(key,id,data){
  const sh=findDedicatedSheet(key);
  if(!sh)return null;
  ensureDedicatedHeaders(key,sh);
  const headers=dedicatedHeaders(sh,key);
  const lastCol=Math.max(sh.getLastColumn(),headers.length);
  const ref=parseDedicatedId(id);
  let rowNumber=null;

  // Caminho principal: id no formato GID:linha.
  if(ref && ref.gid===sh.getSheetId() && ref.row>=2 && ref.row<=sh.getLastRow()){
    rowNumber=ref.row;
  }

  // Fallback robusto: se o id vier de uma versão anterior ou estiver
  // inválido, localiza a aeronave pela Matrícula enviada no payload.
  if(rowNumber===null && key==='aeronaves' && data){
    const matricula=normKey(data['Matrícula']||data.matricula||data.tail||'');
    if(matricula){
      const values=sh.getDataRange().getValues();
      const mapped=buildHeaderMap(key,values[0].map(h=>String(h||'').trim()));
      const idx=mapped.indexOf('Matrícula');
      if(idx>=0){
        for(let i=1;i<values.length;i++){
          if(normKey(values[i][idx])===matricula){ rowNumber=i+1; break; }
        }
      }
    }
  }

  if(rowNumber===null)return null;

  const existing=sh.getRange(rowNumber,1,1,lastCol).getValues()[0];
  const row=existing.slice();
  headers.forEach((h,c)=>{
    if(h && data[h]!==undefined && data[h]!==null) row[c]=data[h];
  });
  sh.getRange(rowNumber,1,1,lastCol).setValues([row]);
  SpreadsheetApp.flush();

  // Confirma a escrita dos campos críticos para evitar falso sucesso.
  if(key==='aeronaves'){
    const check=sh.getRange(rowNumber,1,1,lastCol).getValues()[0];
    const baseIdx=headers.indexOf('Base');
    const backupIdx=headers.indexOf('Backup');
    if(data['Base']!==undefined && baseIdx>=0 && String(check[baseIdx]||'')!==String(data['Base']||'')){
      throw new Error('A Base não foi confirmada pelo Google Sheets.');
    }
    if(data['Backup']!==undefined && backupIdx>=0 && String(check[backupIdx]||'')!==String(data['Backup']||'')){
      throw new Error('O Backup não foi confirmado pelo Google Sheets.');
    }
    const statusIdx=headers.indexOf('Status');
    if(data['Status']!==undefined && statusIdx>=0 && normKey(check[statusIdx])!==normKey(data['Status'])){
      throw new Error('O Status da aeronave não foi confirmado pelo Google Sheets.');
    }
  }
  return Object.assign({id:sh.getSheetId()+':'+rowNumber,ok:true},data);
}

function deleteDedicated(key,id){
  const sh=findDedicatedSheet(key);
  if(!sh)return false;
  const ref=parseDedicatedId(id);
  if(!ref||ref.gid!==sh.getSheetId()||!ref.row||ref.row<2)return false;
  sh.deleteRow(ref.row);
  return true;
}

/* ---------- Login (aba "Usuários") ---------- */
function loginUser(nomeDigitado){
  const nome=String(nomeDigitado||'').trim();
  if(!nome)return{autorizado:false,erro:'Informe o nome.'};

  const usuarios=listDedicated('usuarios');
  const alvo=normKey(nome);

  const achado=usuarios.filter(u=>{
    const cadastrado=normKey(u['Nome']);
    if(!cadastrado)return false;
    return cadastrado===alvo||cadastrado.indexOf(alvo)>=0||alvo.indexOf(cadastrado)>=0;
  });

  if(!achado.length){
    return{
      autorizado:false,
      erro:'Usuário não encontrado na aba Usuários. Confira o nome ou peça ao administrador para cadastrá-lo.'
    };
  }

  if(achado.length>1){
    return{
      autorizado:false,
      erro:'Mais de um usuário encontrado com esse nome. Digite o nome completo.'
    };
  }

  const usuario=achado[0];
  const funcao=String(usuario['Função']||'').trim();
  const funcaoKey=normKey(funcao);
  let permissoes=permissionsForFunction(funcao);
  const rawIndividual=String(usuario['Permissões']||'').trim();
  if(rawIndividual){
    try{
      const individual=JSON.parse(rawIndividual);
      if(individual&&typeof individual==='object'){
        permissoes=Object.assign({},permissoes,individual);
      }
    }catch(e){
      /* Se a coluna estiver com JSON inválido, mantém as permissões do perfil. */
    }
  }

  return{
    autorizado:true,
    nome:String(usuario['Nome']||'').trim(),
    funcao:funcao,
    perfil:funcaoKey==='ADMINISTRADOR'?'ADMINISTRADOR':funcao,
    acesso:accessForFunction(funcao),
    permissoes:permissoes,
    sessionToken:Utilities.getUuid()
  };
}


/* ---------- Segurança administrativa ---------- */
function securitySheet(){
  const ss=mainSS();
  const names=['Segurança','Seguranca'];
  return ss.getSheets().find(s=>names.map(normKey).includes(normKey(s.getName())))||null;
}
function sha256Hex(value){
  const bytes=Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,String(value||''),Utilities.Charset.UTF_8);
  return bytes.map(b=>('0'+(b<0?b+256:b).toString(16)).slice(-2)).join('');
}
function securityHeaders(sh){
  const lastCol=Math.max(sh.getLastColumn(),1);
  const raw=sh.getRange(1,1,1,lastCol).getValues()[0].map(v=>String(v||'').trim());
  const idx={nome:-1,credencial:-1,ativo:-1};
  raw.forEach((h,i)=>{
    const n=normKey(h);
    if(idx.nome<0 && (n==='NOME'||n.includes('NOME')))idx.nome=i;
    if(idx.credencial<0 && (n.includes('CREDENCIAL')||n.includes('SENHA')||n.includes('PASSWORD')))idx.credencial=i;
    if(idx.ativo<0 && (n==='ATIVO'||n.includes('STATUS')))idx.ativo=i;
  });
  return idx;
}
function verifyAdminCredential(nome,senha,base){
  const n=String(nome||'').trim(), s=String(senha||'');
  if(!n)return{autorizado:false,erro:'Informe o nome do administrador.'};
  if(!s)return{autorizado:false,erro:'Digite a credencial administrativa.'};
  const sh=securitySheet();
  if(!sh)return{autorizado:false,erro:'A aba "Segurança" não foi encontrada no Google Sheets.'};
  const idx=securityHeaders(sh);
  if(idx.nome<0||idx.credencial<0)return{autorizado:false,erro:'A aba Segurança precisa ter as colunas Nome e Credencial.'};
  const values=sh.getDataRange().getValues(), alvo=normKey(n), hash=sha256Hex(s);
  for(let r=1;r<values.length;r++){
    const nomeCell=String(values[r][idx.nome]||'').trim();
    if(!nomeCell)continue;
    if(normKey(nomeCell)!==alvo && !normKey(nomeCell).includes(alvo) && !alvo.includes(normKey(nomeCell)))continue;
    if(idx.ativo>=0){
      const ativo=normKey(values[r][idx.ativo]||'SIM');
      if(['NAO','NÃO','INATIVO','INACTIVE','FALSE','0'].includes(ativo))return{autorizado:false,erro:'Esta credencial está inativa.'};
    }
    const cell=String(values[r][idx.credencial]||'').trim();
    const ok=cell.toLowerCase().startsWith('sha256$') ? cell.slice(7).toLowerCase()===hash : cell===s;
    if(!ok)return{autorizado:false,erro:'Credencial inválida.'};
    if(!cell.toLowerCase().startsWith('sha256$'))sh.getRange(r+1,idx.credencial+1).setValue('sha256$'+hash);
    SpreadsheetApp.flush();
    return{autorizado:true,nome:nomeCell,sessionToken:Utilities.getUuid(),base:base||'',perfil:'ADMINISTRADOR',acesso:'Acesso total',permissoes:adminPermissions()};
  }
  return{autorizado:false,erro:'Credencial administrativa não encontrada para este usuário.'};
}
function changeAdminCredential(nome,senha){
  const n=String(nome||'').trim(), s=String(senha||'');
  if(!n||s.length<8)return{ok:false,erro:'Informe o nome e uma nova credencial com pelo menos 8 caracteres.'};
  const sh=securitySheet();
  if(!sh)throw new Error('A aba Segurança não foi encontrada.');
  const idx=securityHeaders(sh);
  if(idx.nome<0||idx.credencial<0)throw new Error('A aba Segurança precisa ter as colunas Nome e Credencial.');
  const values=sh.getDataRange().getValues(), alvo=normKey(n);
  for(let r=1;r<values.length;r++){
    const nomeCell=String(values[r][idx.nome]||'').trim();
    if(normKey(nomeCell)===alvo){
      sh.getRange(r+1,idx.credencial+1).setValue('sha256$'+sha256Hex(s));
      SpreadsheetApp.flush();
      return{ok:true,nome:nomeCell};
    }
  }
  return{ok:false,erro:'Usuário não encontrado na aba Segurança.'};
}

/* ---------- Config (genérico: Bases, Clientes, Rotas, Parâmetros, Usuários, Listas) ---------- */
function listConfig(key){
  if(DEDICATED_SHEETS[key])return listDedicated(key);
  const sh=sheet('Config');
  const rows=sh.getDataRange().getValues();
  const out=[];
  for(let i=1;i<rows.length;i++){
    let[id,rowKey,jsonStr]=rows[i];
    if(!jsonStr)continue; // linha vazia de verdade, ignora
    if(!id){
      /* Mesma cura automática: registro sem id (digitado direto na
         planilha) recebe um id novo na hora de listar. */
      id=String(Date.now())+'-'+i;
      sh.getRange(i+1,1).setValue(id);
    }
    if(rowKey!==key)continue;
    out.push(Object.assign({id:id},JSON.parse(jsonStr)));
  }
  return out;
}
function addConfig(key,data){
  if(DEDICATED_SHEETS[key])return addDedicated(key,data);
  const sh=sheet('Config');
  const id=String(Date.now());
  sh.appendRow([id,key,JSON.stringify(data)]);
  return Object.assign({id:id},data);
}
function updateConfig(key,id,data){
  if(DEDICATED_SHEETS[key]){
    const result=updateDedicated(key,id,data);
    if(!result)throw new Error('Registro de '+key+' não encontrado para atualização: '+id);
    return result;
  }
  const sh=sheet('Config');
  const rows=sh.getDataRange().getValues();
  for(let i=1;i<rows.length;i++){
    if(String(rows[i][0])===String(id)&&rows[i][1]===key){
      sh.getRange(i+1,3).setValue(JSON.stringify(data));
      return Object.assign({id:id},data);
    }
  }
  return null;
}
function deleteConfig(key,id){
  if(DEDICATED_SHEETS[key])return deleteDedicated(key,id);
  const sh=sheet('Config');
  const rows=sh.getDataRange().getValues();
  for(let i=1;i<rows.length;i++){
    if(String(rows[i][0])===String(id)&&rows[i][1]===key){sh.deleteRow(i+1);return true}
  }
  return false;
}

/* ---------- Ações específicas de Aeronaves: Alterar Base / Definir Backup ----------
   Reaproveitam updateDedicated('aeronaves',...), que já sabe localizar a
   linha certa pela Matrícula quando o id não é informado (ver fallback
   dentro de updateDedicated). Aqui só resolvemos: (1) uma ou várias
   aeronaves de uma vez para Base, e (2) uma aeronave para Backup. */
function updateAircraftBaseBulk(tails,base){
  const list=Array.isArray(tails)?tails:(tails?[tails]:[]);
  const limpos=list.map(t=>String(t||'').trim()).filter(Boolean);
  if(!limpos.length)throw new Error('Selecione ao menos uma aeronave.');
  if(!String(base||'').trim())throw new Error('Selecione a nova base.');
  const atualizadas=[];
  limpos.forEach(tail=>{
    const r=updateDedicated('aeronaves',null,{Matrícula:tail,Base:base});
    if(!r)throw new Error('Aeronave "'+tail+'" não encontrada na aba Aeronaves.');
    atualizadas.push(r);
  });
  return{ok:true,updated:atualizadas.length,tails:limpos,base:base};
}
