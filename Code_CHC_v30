function disponibilizarAeronave(tail,dados,actor){
  const t=String(tail||'').trim();
  if(!t)throw new Error('Informe a aeronave para disponibilizar.');
  const d=dados||{};
  const sh=indisponibilidadesSheet();
  const map=indispColumnMap(sh);
  const values=sh.getDataRange().getValues();
  const matriculaIdx=map.matricula,statusIdx=map.status;
  const quem=(actor&&(actor.nome||actor.name))||'';
  const agora=new Date().toISOString();
  const fimComunicado=String(d.fimRealComunicado||agora);
  let achou=false;
  for(let i=values.length-1;i>=1;i--){
    if(normKey(values[i][matriculaIdx])===normKey(t)&&String(values[i][statusIdx])==='ABERTA'){
      const updates={status:'CONCLUIDA',observacaoRetorno:String(d.observacao||d.obs||''),disponibilizadoPor:quem,disponibilizadoEm:fimComunicado};
      if(d.fimRealValidado)updates.fimRealValidado=String(d.fimRealValidado);
      ['paneConstatada','ordemServico','referenciaTecnica','localPane','responsavelInformacao','acaoCorretiva'].forEach(k=>{if(d[k]!==undefined)updates[k]=String(d[k]||'');});
      setIndispRowFields(sh,i+1,updates);achou=true;break;
    }
  }
  SpreadsheetApp.flush();
  updateAircraftStatusSingle(t,'DISPONIVEL');
  return {ok:true,eventoFechado:achou};
}
function atualizarIndisponibilidadeAberta(tail,dados,actor){
  const t=String(tail||'').trim();
  if(!t)throw new Error('Informe a aeronave para atualizar a indisponibilidade.');
  const d=dados||{},sh=indisponibilidadesSheet(),map=indispColumnMap(sh),values=sh.getDataRange().getValues();
  let rowNumber=null;
  for(let i=values.length-1;i>=1;i--){
    if(normKey(values[i][map.matricula])===normKey(t)&&String(values[i][map.status])==='ABERTA'){rowNumber=i+1;break;}
  }
  if(rowNumber===null)throw new Error('Não há indisponibilidade em aberto para "'+t+'".');
  const campos=['tipoIndisponibilidade','descricaoBR','descricaoEN','inspetor','mecanico','ata','previsaoRTS','tripulacao','programacaoCumprida','vooTransferido','numeroVoo','numeroPax','destino','acionamento','corte','emails','acaoCorretiva','inicioPrevisto'];
  const updates={};campos.forEach(c=>{if(d[c]!==undefined&&d[c]!==null)updates[c]=String(d[c]);});
  if(Object.keys(updates).length)setIndispRowFields(sh,rowNumber,updates);
  SpreadsheetApp.flush();
  return {ok:true,atualizado:true};
}
function listIndisponibilidadesAbertas(){
  const sh=indisponibilidadesSheet(),values=sh.getDataRange().getValues(),map=indispColumnMap(sh),porAeronave={};
  for(let i=1;i<values.length;i++){
    if(String(values[i][map.status])!=='ABERTA')continue;
    const tail=String(values[i][map.matricula]||'').trim();if(!tail)continue;
    porAeronave[tail]=indispRowToObj(values[i],sh);
  }
  return Object.values(porAeronave);
}
function listIndisponibilidadesHistorico(tail,dias){
  const sh=indisponibilidadesSheet(),values=sh.getDataRange().getValues(),map=indispColumnMap(sh),t=tail?normKey(tail):'';
  const limite=dias?new Date(Date.now()-Number(dias)*24*60*60*1000):null,out=[];
  for(let i=1;i<values.length;i++){
    if(!values[i][map.id])continue;
    if(String(values[i][map.status])!=='CONCLUIDA')continue;
    if(t&&normKey(values[i][map.matricula])!==t)continue;
    if(limite&&values[i][map.disponibilizadoEm]&&new Date(values[i][map.disponibilizadoEm])<limite)continue;
    out.push(indispRowToObj(values[i],sh));
  }
  out.sort((a,b)=>String(b.disponibilizadoEm).localeCompare(String(a.disponibilizadoEm)));
  return out;
}

/* ---------- Tradução automática BR->EN da Descrição Reportada (v24) ----------
   Usa o serviço LanguageApp, nativo do Google Apps Script — não depende de
   nenhuma chave de API externa nem de custo adicional.
   v25: antes, qualquer falha do LanguageApp.translate() era engolida e a
   função devolvia '' silenciosamente — o campo EN ficava em branco sem
   nenhum aviso, dando a impressão de "a tradução não faz nada". Agora o
   erro é repassado para cima, para o handler global (catch em handle())
   devolver {error:...} e o front-end mostrar "Não foi possível traduzir
   automaticamente — edite manualmente." no lugar de falhar em silêncio. */
function translatePtToEn(texto){
  const t=String(texto||'').trim();
  if(!t)return '';
  return LanguageApp.translate(t,'pt','en');
}

/* ---------- Envio de e-mail (v30) ----------
   Manda o e-mail de aviso de indisponibilidade/disponibilização de
   verdade, pela conta Google que publicou este Web App — o coordenador
   não precisa mais abrir o próprio app de e-mail e clicar em enviar.
   'to' aceita vários endereços separados por vírgula/ponto e vírgula
   (é o mesmo formato que já vem do campo "Enviar e-mail para" do front-end).
   Chega normalmente em qualquer provedor do destinatário, Outlook incluído
   — só muda quem manda (a conta Google do script), não quem recebe. */
function enviarEmailIndisponibilidade(d){
  const to=String(d.to||'').trim().replace(/;/g,',');
  const subject=String(d.subject||'').trim();
  const body=String(d.body||'');
  if(!to)throw new Error('Informe ao menos um destinatário.');
  if(!subject)throw new Error('Assunto do e-mail vazio.');
  MailApp.sendEmail({to:to,subject:subject,body:body});
  return {ok:true,enviadoPara:to};
}

/* ---------- Histórico de Disponibilidade da Frota (indicadores de tendência) ----------
   Guarda, uma linha por dia, o retrato da frota (quantas disponíveis, em
   manutenção, indisponíveis etc.) para permitir comparar "hoje" com a
   média dos últimos dias. Diferente da aba "Histórico" (que registra
   alterações de VOOS), esta é específica de disponibilidade de AERONAVES.
   É atualizada (upsert, por data) sempre que: (1) alguém troca o status de
   uma aeronave, ou (2) o Painel da Frota é aberto no app — assim o dado do
   dia vai ficando mais preciso conforme o dia passa, sem precisar de
   gatilho (trigger) agendado no Apps Script. */
function fleetAvailabilitySheet(){
  const sh=sheet('HistoricoDisponibilidade');
  if(sh.getLastRow()===0)sh.appendRow(['data','disponiveis','indisponiveis','manutencao','totalFrota','percentual','atualizadoEm']);
  return sh;
}
function computeFleetAvailabilitySnapshotNow(){
  const rows=listDedicated('aeronaves');
  let disponiveis=0,manutencao=0,indisponiveis=0;
  rows.forEach(r=>{
    const status=String(r['Status']||r.status||r['Disponibilidade']||'').trim();
    if(/MANUTEN/i.test(status)){manutencao++;return;}
    if(/DISPON|ATIVO|OPERACIONAL/i.test(status)&&!/INDISPON|FORA|INATIVO/i.test(status)){disponiveis++;}
    else{indisponiveis++;}
  });
  const total=rows.length;
  const percentual=total?Math.round((disponiveis/total)*1000)/10:0;
  return {disponiveis:disponiveis,indisponiveis:indisponiveis,manutencao:manutencao,totalFrota:total,percentual:percentual};
}
function registrarSnapshotDisponibilidade(){
  const snap=computeFleetAvailabilitySnapshotNow();
  const hoje=Utilities.formatDate(new Date(),Session.getScriptTimeZone()||'America/Sao_Paulo','yyyy-MM-dd');
  const sh=fleetAvailabilitySheet();
  const values=sh.getDataRange().getValues();
  try{registrarSnapshotDisponibilidadePorModelo();}catch(e){} // não deve travar o snapshot geral por causa da quebra por modelo
  for(let i=1;i<values.length;i++){
    if(String(values[i][0])===hoje){
      sh.getRange(i+1,1,1,7).setValues([[hoje,snap.disponiveis,snap.indisponiveis,snap.manutencao,snap.totalFrota,snap.percentual,new Date()]]);
      return Object.assign({data:hoje},snap);
    }
  }
  sh.appendRow([hoje,snap.disponiveis,snap.indisponiveis,snap.manutencao,snap.totalFrota,snap.percentual,new Date()]);
  return Object.assign({data:hoje},snap);
}

/* ---------- Histórico de Disponibilidade POR MODELO (S-92 x AW139 x outros) ----------
   Guarda, em aba separada, uma linha por dia+modelo. Não mexe na aba
   "HistoricoDisponibilidade" já existente (mantém compatibilidade com quem já
   consome o snapshot geral da frota) — esta é usada só pelo gráfico de
   tendência de disponibilidade por frota em Configurações > Indicadores
   Operacionais. Usa a mesma normalização de modelo já usada no Painel da
   Frota (ver fleetHealthRows no HTML) para separar AW139 de S-92. */
function fleetAvailabilityModelSheet(){
  const sh=sheet('HistoricoDisponibilidadeModelo');
  if(sh.getLastRow()===0)sh.appendRow(['data','modelo','disponiveis','total','percentual','atualizadoEm']);
  return sh;
}
function modelKeyFor(modeloStr){
  const m=String(modeloStr||'').toUpperCase().replace(/[-\s]/g,'');
  if(m.includes('AW139'))return 'AW139';
  if(m.includes('S92'))return 'S92';
  return 'OUTROS';
}
function computeFleetAvailabilityByModelSnapshotNow(){
  const rows=listDedicated('aeronaves');
  const byModel={};
  rows.forEach(r=>{
    const modelo=modelKeyFor(r['Modelo']||r.modelo||'');
    const status=String(r['Status']||r.status||r['Disponibilidade']||'').trim();
    if(!byModel[modelo])byModel[modelo]={disponiveis:0,total:0};
    byModel[modelo].total++;
    const disponivel=/DISPON|ATIVO|OPERACIONAL/i.test(status)&&!/INDISPON|FORA|INATIVO|MANUTEN/i.test(status);
    if(disponivel)byModel[modelo].disponiveis++;
  });
  Object.keys(byModel).forEach(k=>{
    const b=byModel[k];
    b.percentual=b.total?Math.round((b.disponiveis/b.total)*1000)/10:0;
  });
  return byModel;
}
function registrarSnapshotDisponibilidadePorModelo(){
  const snap=computeFleetAvailabilityByModelSnapshotNow();
  const hoje=Utilities.formatDate(new Date(),Session.getScriptTimeZone()||'America/Sao_Paulo','yyyy-MM-dd');
  const sh=fleetAvailabilityModelSheet();
  const values=sh.getDataRange().getValues();
  Object.keys(snap).forEach(modelo=>{
    const b=snap[modelo];
    let found=false;
    for(let i=1;i<values.length;i++){
      if(String(values[i][0])===hoje&&String(values[i][1])===modelo){
        sh.getRange(i+1,1,1,6).setValues([[hoje,modelo,b.disponiveis,b.total,b.percentual,new Date()]]);
        found=true;break;
      }
    }
    if(!found)sh.appendRow([hoje,modelo,b.disponiveis,b.total,b.percentual,new Date()]);
  });
  return Object.assign({data:hoje},snap);
}
function listFleetAvailabilityHistoryByModel(dias){
  const n=Number(dias)||180;
  const sh=fleetAvailabilityModelSheet();
  const values=sh.getDataRange().getValues();
  const out=[];
  for(let i=1;i<values.length;i++){
    if(!values[i][0])continue;
    out.push({
      data:String(values[i][0]),
      modelo:String(values[i][1]),
      disponiveis:Number(values[i][2])||0,
      total:Number(values[i][3])||0,
      percentual:Number(values[i][4])||0
    });
  }
  out.sort((a,b)=>a.data.localeCompare(b.data));
  const datasUnicas=[...new Set(out.map(o=>o.data))].sort();
  const datasValidas=new Set(datasUnicas.slice(-n));
  return out.filter(o=>datasValidas.has(o.data));
}
function listFleetAvailabilityHistory(dias){
  const n=Number(dias)||30;
  const sh=fleetAvailabilitySheet();
  const values=sh.getDataRange().getValues();
  const out=[];
  for(let i=1;i<values.length;i++){
    if(!values[i][0])continue;
    out.push({
      data:String(values[i][0]),
      disponiveis:Number(values[i][1])||0,
      indisponiveis:Number(values[i][2])||0,
      manutencao:Number(values[i][3])||0,
      totalFrota:Number(values[i][4])||0,
      percentual:Number(values[i][5])||0
    });
  }
  out.sort((a,b)=>a.data.localeCompare(b.data));
  return out.slice(-n);
}

