/* ---------- Indisponibilidade de Aeronaves (histórico completo — v24) ----------
   Uma linha por EVENTO de indisponibilidade (não por aeronave). Enquanto o
   evento está em aberto, status='ABERTA' e os campos de disponibilização
   ficam vazios; ao disponibilizar, a mesma linha é fechada (status vira
   'CONCLUIDA' e os campos de disponibilização são preenchidos) — assim dá
   pra calcular depois quanto tempo cada aeronave ficou parada.

   NOVIDADE v24: formulário completo (modal "Indisponibilizar" no front-end),
   com tipo, data/hora de início, descrição BR/EN (traduzida automaticamente
   via LanguageApp — ver translatePtToEn mais abaixo), inspetor, mecânico
   responsável, ATA, previsão de disponibilidade (RTS), tripulação do
   reporte, se a programação prevista foi cumprida e, quando não foi, os
   dados da Ocorrência (voo transferido, número do voo, PAX, destino,
   acionamento, corte).

   As colunas são referenciadas pelo NOME (INDISP_HEADERS), não por posição
   fixa — assim, se algum campo novo precisar ser adicionado no futuro, basta
   incluir na lista abaixo, sem risco de embaralhar os dados já gravados nas
   colunas existentes. */
const INDISP_HEADERS=[
  'id','matricula','tipoIndisponibilidade','dataInicio','descricaoBR','descricaoEN',
  'inspetor','mecanico','ata','previsaoRTS','tripulacao','programacaoCumprida',
  'vooTransferido','numeroVoo','numeroPax','destino','acionamento','corte',
  'emails','status','indisponibilizadoPor','indisponibilizadoEm',
  'observacaoRetorno','disponibilizadoPor','disponibilizadoEm',
  'numeroRef','acaoCorretiva','inicioPrevisto','fimRealValidado',
  'paneConstatada','ordemServico','referenciaTecnica','localPane','responsavelInformacao'
];

/* v29 — A aba pode ter sido criada por versões anteriores e sua ordem de
   colunas não deve ser presumida. A versão anterior dizia que gravava por
   nome, mas vários pontos ainda usavam índices fixos de INDISP_HEADERS.
   Aqui a coluna real é localizada pelo cabeçalho normalizado; colunas novas
   são acrescentadas no final. Isso preserva dados antigos e evita que um
   campo digitado caia em outra coluna. */
