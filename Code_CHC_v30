function normHeader(v){return normKey(v);}
function indisponibilidadesSheet(){
  const sh=sheet('Indisponibilidades');
  if(sh.getLastRow()===0){
    sh.getRange(1,1,1,INDISP_HEADERS.length).setValues([INDISP_HEADERS]);
  }else{
    const lastCol=Math.max(sh.getLastColumn(),1);
    const raw=sh.getRange(1,1,1,lastCol).getValues()[0].map(v=>String(v||'').trim());
    const normalized=new Set(raw.map(normHeader).filter(Boolean));
    const missing=[];
    INDISP_HEADERS.forEach(c=>{
      const candidates=[c,...(INDISP_HEADER_ALIASES[c]||[])];
      if(!candidates.some(x=>normalized.has(normHeader(x))))missing.push(c);
    });
    if(missing.length)sh.getRange(1,lastCol+1,1,missing.length).setValues([missing]);
  }
  return sh;
}
function indispColumnMap(sh){
  const lastCol=Math.max(sh.getLastColumn(),1);
  const raw=sh.getRange(1,1,1,lastCol).getValues()[0].map(v=>String(v||'').trim());
  const map={};
  INDISP_HEADERS.forEach(c=>{
    const candidates=[c,...(INDISP_HEADER_ALIASES[c]||[])].map(normHeader);
    for(let i=0;i<raw.length;i++){
      if(candidates.includes(normHeader(raw[i]))){map[c]=i;break;}
    }
  });
  return map;
}
function indispRowToObj(row,sh){
  const map=indispColumnMap(sh||indisponibilidadesSheet());
  const obj={};
  INDISP_HEADERS.forEach(h=>{
    const i=map[h];
    obj[h]=(i!==undefined && row[i]!==undefined && row[i]!==null)?String(row[i]):'';
  });
  return obj;
}
function setIndispRowFields(sh,rowNumber,updates){
  const map=indispColumnMap(sh);
  Object.keys(updates||{}).forEach(h=>{
    const idx=map[h];
    if(idx!==undefined)sh.getRange(rowNumber,idx+1).setValue(updates[h]);
  });
}
