function auditFlightDiff(oldF,newF,actor,tipo){
  const sh=auditSheet(), a=auditActor(actor), now=new Date();
  const oldObj=oldF||{}, newObj=newF||{};
  const labelMap={
    dataVoo:'Data do voo',base:'Base',cliente:'Cliente',flightNo:'Número do voo',reg:'Prefixo',model:'Modelo',horario:'Horário',
    cp:'CP',fo:'FO',fa:'FA',destino:'Rota/Destino',status:'Status',finalizadoEm:'Finalização',motivoTransferencia:'Motivo da transferência',
    passageiro:'Peso de passageiro',bagagem:'Peso de bagagem',carga:'Peso de carga',tripulacao:'Peso da tripulação',combustivelTotal:'Combustível total',
    acionamento:'Acionamento',decolagem:'Decolagem',pousoUnidade:'Pouso na unidade',altitude:'Altitude',combustivelMomento:'Combustível do momento',
    estimadoPouso:'Estimado de pouso',corte:'Corte',pax:'Pax',motivoAtraso:'Motivo do atraso',codigoAtraso:'Código de atraso',observacaoAtraso:'Observação do atraso'
  };
  const scalarKeys=['dataVoo','base','cliente','flightNo','reg','model','horario','cp','fo','fa','destino','status','finalizadoEm','motivoTransferencia'];
  const changes=[];
  const norm=v=>v===null||v===undefined?'':String(v);
  scalarKeys.forEach(k=>{const ov=norm(oldObj[k]),nv=norm(newObj[k]);if(ov!==nv)changes.push({campo:labelMap[k]||k,old:ov,new:nv});});
  const diffObj=(prefix,oldVal,newVal)=>{
    const keys=new Set([...Object.keys(oldVal||{}),...Object.keys(newVal||{})]);
    keys.forEach(k=>{
      const ov=oldVal?oldVal[k]:undefined,nv=newVal?newVal[k]:undefined;
      const bothObj=ov&&typeof ov==='object'&&!Array.isArray(ov)&&nv&&typeof nv==='object'&&!Array.isArray(nv);
      if(bothObj){diffObj(prefix+'.'+k,ov,nv);return;}
      const os=norm(ov),ns=norm(nv);if(os!==ns){
        const label=labelMap[k]||k.replace(/([A-Z])/g,' $1').replace(/^./,x=>x.toUpperCase());
        changes.push({campo:(prefix?prefix+' — ':'')+label,old:os,new:ns});
      }
    });
  };
  diffObj('Peso',oldObj.pesos||{},newObj.pesos||{});
  const oldLog=oldObj.logVoo||{},newLog=newObj.logVoo||{};
  diffObj('Log — IDA',oldLog.ida||{},newLog.ida||{});
  diffObj('Log — VOLTA',oldLog.volta||{},newLog.volta||{});
  ['motivoAtraso','codigoAtraso','observacaoAtraso'].forEach(k=>{const ov=norm(oldLog[k]),nv=norm(newLog[k]);if(ov!==nv)changes.push({campo:labelMap[k],old:ov,new:nv});});
  const ref=Object.assign({},newObj||oldObj);
  if(!changes.length)changes.push({campo:'Operação',old:'',new:'Registro de '+tipo.toLowerCase()});
  changes.forEach(ch=>sh.appendRow([now,a.nome,a.funcao,String(ref.id||''),String(ref.dataVoo||''),String(ref.base||''),String(ref.cliente||''),String(ref.flightNo||''),String(ref.reg||''),tipo,ch.campo,ch.old,ch.new,'']));
  SpreadsheetApp.flush();
}
