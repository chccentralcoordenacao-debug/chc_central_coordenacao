/* ==========================================================================
   ITEM DE EVOLUÇÃO #2 — BACKUP AUTOMÁTICO DIÁRIO
   --------------------------------------------------------------------------
   COMO INSTALAR (uma vez só):
   1. Abra o projeto do Apps Script (o mesmo onde está o Code.gs de produção)
   2. Crie um NOVO arquivo de script (Arquivo → Novo → Script) e cole todo
      este conteúdo nele — pode ficar separado do Code.gs principal, não
      precisa misturar
   3. No arquivo, troque BACKUP_FOLDER_ID abaixo pelo ID de uma pasta do
      Google Drive onde os backups devem ser salvos (crie uma pasta chamada
      "CHC - Backups" e pegue o ID dela na URL, a parte depois de /folders/)
   4. Rode a função installBackupTrigger() UMA VEZ manualmente (selecione ela
      no dropdown de funções e clique em ▷ Executar) — isso instala o
      gatilho diário. Vai pedir permissão na primeira vez, autorize.
   5. Pronto. A partir daí, todo dia às 3h da manhã, uma cópia completa da
      planilha de produção é salva automaticamente nessa pasta, com a data
      no nome. Você não precisa fazer mais nada — é isso que torna esse
      backup diferente do botão "Exportar Dados (.json)" que já existe nas
      Configurações do app (aquele depende de alguém lembrar de clicar).

   MANUTENÇÃO:
   - runBackupNow() faz um backup manual imediato, se quiser testar
   - cleanupOldBackups() apaga backups com mais de RETENTION_DAYS dias, para
     a pasta não crescer para sempre (chamada automaticamente a cada backup)
   ========================================================================== */

const BACKUP_FOLDER_ID = 'COLE_AQUI_O_ID_DA_PASTA_DO_DRIVE'; // <-- editar
const RETENTION_DAYS = 30; // quantos dias de histórico manter

function installBackupTrigger() {
  // Remove um gatilho antigo com o mesmo nome, se existir, para não duplicar
  ScriptApp.getProjectTriggers().forEach(t => {
    if (t.getHandlerFunction() === 'runScheduledBackup') {
      ScriptApp.deleteTrigger(t);
    }
  });
  ScriptApp.newTrigger('runScheduledBackup')
    .timeBased()
    .atHour(3)
    .everyDays(1)
    .create();
  Logger.log('Gatilho de backup diário instalado (todo dia às 3h).');
}

function runScheduledBackup() {
  runBackupNow();
  cleanupOldBackups();
}

function runBackupNow() {
  const sourceFile = DriveApp.getFileById(SpreadsheetApp.getActive().getId());
  const folder = DriveApp.getFolderById(BACKUP_FOLDER_ID);
  const timestamp = Utilities.formatDate(new Date(), Session.getScriptTimeZone() || 'America/Sao_Paulo', 'yyyy-MM-dd_HH-mm');
  const backupName = 'CHC_backup_' + timestamp;
  const copy = sourceFile.makeCopy(backupName, folder);
  Logger.log('Backup criado: ' + copy.getName() + ' (' + copy.getId() + ')');
  return copy;
}

function cleanupOldBackups() {
  const folder = DriveApp.getFolderById(BACKUP_FOLDER_ID);
  const cutoff = new Date(Date.now() - RETENTION_DAYS * 24 * 60 * 60 * 1000);
  const files = folder.getFilesByName ? null : null; // (mantido só como comentário de referência)
  const it = folder.getFiles();
  let removed = 0;
  while (it.hasNext()) {
    const f = it.next();
    if (f.getName().indexOf('CHC_backup_') === 0 && f.getDateCreated() < cutoff) {
      f.setTrashed(true);
      removed++;
    }
  }
  if (removed) Logger.log('Backups antigos removidos: ' + removed);
}
